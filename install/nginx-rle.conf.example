# Reverse proxy for the Remote Lab portal.
#
# The portal is not an ordinary request/response app: the lab page holds an
# open WebSocket for the serial console, plotter, oscilloscope and debugger,
# and streams MJPEG from the bench camera. A default proxy_pass block breaks
# both - it proxies as HTTP/1.0, which cannot carry a WebSocket upgrade, and
# buffers responses, which stalls a stream that never ends.

# --- http context (put this in /etc/nginx/conf.d/websocket-upgrade.conf) ---
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }

server {
    listen 80;
    server_name rle.cce.iisc.ac.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name rle.cce.iisc.ac.in;

    ssl_certificate     /etc/ssl/certs/rle.crt;
    ssl_certificate_key /etc/ssl/private/rle.key;

    # Firmware images are capped at 8 MB by the application.
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:5001;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket. Without these three the /socket.io/ upgrade is proxied as
        # HTTP/1.0, the handshake fails, and the lab page loses serial, the
        # plotter, the oscilloscope and the debugger while still looking
        # connected - the camera keeps working, so the page appears healthy.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # A lab session is an hour; the default 60s read timeout would drop
        # the socket mid-experiment.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # MJPEG and the relay are streams. Buffering them adds latency and can
        # stall the camera feed entirely.
        proxy_buffering off;
    }
}
