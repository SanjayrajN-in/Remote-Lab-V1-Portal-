[Unit]
Description=Remote Lab portal (master server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
UMask=0077
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
# Single worker, many threads: the lab page's SocketIO relay
# (services/pi_relay.py, services/audio_relay.py) keeps per-session state in
# process memory, so a second worker process would not see it. Matches
# remote_lab_admin's deployed config, which runs the same relay this way.
ExecStart=__APP_DIR__/venv/bin/gunicorn \
    --worker-class gthread \
    --workers 1 \
    --threads 12 \
    --timeout 120 \
    --bind 127.0.0.1:__PORT__ \
    --access-logfile - \
    --error-logfile - \
    wsgi:application
Restart=always
RestartSec=5

# --- containment -----------------------------------------------------------
# The service account owns only the three directories it writes to; the source
# tree is root-owned, so a file-write primitive in the web tier cannot turn
# into code execution on the next restart.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# read-only rather than true because the application currently lives under
# /home. Move APP_DIR to /opt and this can become ProtectHome=true.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

# Only these two are writable (lab manuals are in data/sop/). Everything
# else, including the source, static/ and the virtualenv, is read-only.
ReadWritePaths=__APP_DIR__/data __APP_DIR__/uploads

# Bounds, so the resource-exhaustion paths cannot take the host with them.
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
