# Copy to .env and edit. Never commit the real .env.

SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32
PORTAL_BASE_URL=http://<portal-host>:5000

# Shared secret every Lab Pi must present. Put the same value in each node's .env.
NODE_SHARED_SECRET=generate-another-long-random-string

# Accept existing Lab Pis that post to /api/lab-pi/... without a secret.
# Set to false once every node runs install/node_integration.py.
LEGACY_NODE_COMPAT=true

# The lab page relays serial/chart/oscilloscope/camera/audio through the
# portal instead of an iframe to the node's own address. false rolls back to
# the old iframe page instantly (restart required).
NATIVE_LAB_UI=true
# Fixed ports every node image exposes alongside its main app (node.port):
# ustreamer (camera) and the aiortc audio server's /offer endpoint.
CAMERA_PORT=8080
AUDIO_PORT=9000

# SQLite by default. For Postgres:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/remotelab

# Email. Leave MAIL_SERVER unset and invitations are written to the log instead.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Remote Lab <no-reply@vlab.edu>

# Display timezone. Stored values are always UTC.
TIMEZONE=Asia/Kolkata
TIMEZONE_LABEL=IST

# Booking policy
SLOT_MINUTES=60
MAX_ADVANCE_DAYS=14
MAX_OPEN_BOOKINGS_PER_USER=3

# Ranges the portal may make outbound node requests to. Defaults to the
# RFC1918 ranges, which is broad - narrow it to your actual bench subnet so
# a node cannot report an address on some other network and have the portal
# accept it. e.g. LAB_NODE_CIDRS=10.166.12.0/24
LAB_NODE_CIDRS=

# Ports a bench serves. Default: 5000,8080,9000,10000
NODE_ALLOWED_PORTS=
